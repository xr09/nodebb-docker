# Copy to .env and edit before the first `docker compose up`.
#
#   cp .env.example .env
#
# Generate the secrets with:  openssl rand -hex 32
#
# These are read only at first install, when setup.sh writes config.json — except
# the mongo ones, which the forum also reads on every start. Changing a password
# later means changing it in Mongo and in config.json, not just here.

# Public URL of the forum. Must match how people actually reach it, including
# scheme and port; NodeBB builds absolute links and CSRF checks from it.
NODEBB_URL=http://localhost:4567

# Host port to publish. The container always listens on 4567.
NODEBB_PORT=4567

# Session secret. Rotating it logs everyone out.
NODEBB_SECRET=change-me-openssl-rand-hex-32

# Mongo. MONGO_USERNAME is created in MONGO_DATABASE on first run, with
# readWrite on that database only.
MONGO_ROOT_PASSWORD=change-me-too
MONGO_USERNAME=nodebb
MONGO_PASSWORD=change-me-as-well
MONGO_DATABASE=nodebb

# First administrator account.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-8-chars

# Space-separated plugins to bake into the image, pinned. Changing this needs
# `docker compose up -d --build`; the plugin layer rebuilds, the core install
# stays cached.
# PLUGINS=nodebb-plugin-foo@1.2.3 nodebb-theme-bar@2.0.0
