# The build context is only ever this repo's own metadata — NodeBB itself is
# cloned inside the Dockerfile — so almost everything here is noise that would
# only serve to invalidate the build cache.
.git
.github
*.md
LICENSE

# Deployment example. setup.sh is bind-mounted by compose, never baked in, and
# .env would be secrets in the build context.
compose.yaml
setup.sh
.env
.env.example
